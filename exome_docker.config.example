# ==============================================================================
# exome_docker.config.example
# Host-side mount configuration for exome_docker.sh
# ==============================================================================

# Tagged production image
IMAGE_NAME="wes-pipeline:0.1.0"

# Absolute paths on the host machine
HOST_DATA_DIR="/absolute/path/to/fastq"
HOST_REFERENCE_DIR="/absolute/path/to/reference"
HOST_RESULTS_DIR="/absolute/path/to/results"
HOST_LOGS_DIR="/absolute/path/to/logs"

# Mount destinations inside the Docker container
CONTAINER_DATA_DIR="/data"
CONTAINER_REFERENCE_DIR="/resources"
CONTAINER_RESULTS_DIR="/results"
CONTAINER_LOGS_DIR="/logs"
CONTAINER_SAMPLESHEET_PATH="/tmp/samplesheet.csv"

# Resource ceilings enforced by the Docker daemon
DOCKER_CPUS="8"
DOCKER_MEMORY="32g"
